      "source": [
        "l=[]\n",
        "print(\"Enter marks of 5 subjects:\")\n",
        "for i in range(0,5):\n",
        "  n=int(input())\n",
        "  l.append(n)\n",
        "avg=int(sum(l)/len(l))\n",
        "if avg>=90 and avg<=100:\n",
        "  g='A'\n",
        "elif avg>=75:\n",
        "  g='B'\n",
        "elif avg>=60:\n",
        "  g='C'\n",
        "elif avg>=45:\n",
        "  g='D'\n",
        "elif avg>=30:\n",
        "  g='E'\n",
        "else:\n",
        "  g='F'\n",
        "print(\"Grade: \",g)"
      ]
    }
  ]
